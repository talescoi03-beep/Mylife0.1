# Copy to .env for local development (never commit .env).
# On Render, set these in each service's Environment tab instead.

# ---- Frontend (static site) — PUBLIC values only; they end up in the browser ----
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Settings → API Keys → Publishable key (starts with sb_publishable_)
PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# URL of the backend service (leave empty if you don't deploy it; account deletion is then unavailable)
PUBLIC_API_URL=https://my-life-api.onrender.com

# ---- Backend (Render web service) — SECRET values, server only ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Supabase → Settings → API Keys → Secret key (starts with sb_secret_). Bypasses all security rules.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Your static site address, exactly as it appears in the browser (no trailing slash)
ALLOWED_ORIGINS=https://my-life.onrender.com
